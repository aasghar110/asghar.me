# Public analytics identifier. Leave empty to disable analytics and its consent UI.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
# Optional HTML verification token. DNS ownership verification needs no code token.
GOOGLE_SITE_VERIFICATION=
# Gmail SMTP. Use a Google App Password, never your normal account password.
# Legacy EMAIL_USER / EMAIL_PASS names are also supported.
SMTP_USER=aasghar5445@gmail.com
SMTP_PASS=
# Optional distributed rate limiting: configure all three values together.
# Without these, a best-effort per-instance limit is used.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Random 32+ character secret for hashing rate-limit identifiers.
CONTACT_RATE_LIMIT_SECRET=
